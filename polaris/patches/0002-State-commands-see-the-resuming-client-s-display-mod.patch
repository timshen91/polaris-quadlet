From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tim Shen <timshen91@gmail.com>
Date: Mon, 26 Oct 2026 08:50:48 +0900
Subject: [PATCH 2/2] State commands see the resuming client's display mode

A resume runs the app's state commands with the environment built when the
app launched, so POLARIS_CLIENT_WIDTH/HEIGHT/FPS (and NAME) still describe the
launching client. A command that sizes a display for the stream, run on
resume, then sizes it for the wrong client. Refresh them from the resuming
session's stream configuration first.
---
 src/process.cpp | 11 +++++++++++
 src/process.h   |  7 +++++++
 src/stream.cpp  |  6 ++++++
 3 files changed, 24 insertions(+)

diff --git a/src/process.cpp b/src/process.cpp
index 6e0e6d9..52f0113 100644
--- a/src/process.cpp
+++ b/src/process.cpp
@@ -9942,6 +9942,17 @@ namespace proc {
     return 0;
   }
 
+  void proc_t::update_client_display(const std::string &device_name, int width, int height, int framerate) {
+    auto &sync = session_lifecycle_sync();
+    std::lock_guard<std::recursive_mutex> lifecycle_lock(sync.mutex);
+    _env["POLARIS_CLIENT_NAME"] = device_name;
+    _env["POLARIS_CLIENT_WIDTH"] = std::to_string(width);
+    _env["POLARIS_CLIENT_HEIGHT"] = std::to_string(height);
+    _env["POLARIS_CLIENT_RENDER_WIDTH"] = std::to_string(width);
+    _env["POLARIS_CLIENT_RENDER_HEIGHT"] = std::to_string(height);
+    _env["POLARIS_CLIENT_FPS"] = std::format("{:.3f}", static_cast<double>(framerate));
+  }
+
   void proc_t::resume() {
     auto &sync = session_lifecycle_sync();
     std::lock_guard<std::recursive_mutex> lifecycle_lock(sync.mutex);
diff --git a/src/process.h b/src/process.h
index b3504f7..a4cb72e 100644
--- a/src/process.h
+++ b/src/process.h
@@ -958,6 +958,13 @@ namespace proc {
       bool require_exact_token
     );
     boost::process::v1::environment get_env();
+    /**
+     * @brief Point the client display variables at a resuming client's stream.
+     *
+     * The app's environment is built at launch, so without this the state commands a resume
+     * runs would see the launching client's mode, not that of the client resuming it.
+     */
+    void update_client_display(const std::string &device_name, int width, int height, int framerate);
     void resume();
     void pause();
     void terminate(bool immediate = false, bool needs_refresh = true);
diff --git a/src/stream.cpp b/src/stream.cpp
index fbacb54..17affbb 100644
--- a/src/stream.cpp
+++ b/src/stream.cpp
@@ -3190,6 +3190,12 @@ namespace stream {
       }
       if (uses_host_process(session) && ++running_host_sessions == 1) {
         cancel_disconnect_resume_timeout();
+        proc::proc.update_client_display(
+          session.device_name,
+          session.config.monitor.width,
+          session.config.monitor.height,
+          session.config.monitor.framerate
+        );
         proc::proc.resume();
       }
       generation_boundary_lock.unlock();
