# Polaris game stream host, packaged for rootless podman on SteamOS.
# Built by ../polaris.build; run by ../polaris.container.
# To upgrade: bump POLARIS_VERSION/POLARIS_SHA256 (the release asset's digest),
# then `systemctl --user restart polaris-build polaris`.
FROM docker.io/library/archlinux:latest

ARG POLARIS_VERSION=1.4.13
ARG POLARIS_SHA256=cabab97cc37accb70553f7d27b038f122dd5e513d7632a2be5ec137e549b4b72

# Intel and AMD VAAPI/QSV/Vulkan userspace for the encoder. (NVIDIA would need
# nvidia-utils matching the host's driver version; not covered here.)
RUN pacman -Syu --noconfirm \
      mesa intel-media-driver vpl-gpu-rt vulkan-intel vulkan-radeon \
 && curl -fsSL -o /tmp/polaris.pkg.tar.zst \
      "https://github.com/papi-ux/polaris/releases/download/v${POLARIS_VERSION}/Polaris-arch-x86_64.pkg.tar.zst" \
 && echo "${POLARIS_SHA256}  /tmp/polaris.pkg.tar.zst" | sha256sum -c - \
 && pacman -U --noconfirm /tmp/polaris.pkg.tar.zst \
 && rm -f /tmp/polaris.pkg.tar.zst \
 && pacman -Scc --noconfirm

# Polaris launches Steam titles by running `steam ...`. Forward that to the host's
# /usr/bin/steam as a transient host user unit (via the mounted user bus), which
# hands steam:// URLs and -applaunch to the already-running Steam client.
# systemd-run drops the caller's env, so forward the display Polaris picked (its
# Private Stream labwc) and the POLARIS_* tags it uses to find its own Steam.
# In /usr/bin, not /usr/local/bin: Private Stream runs its command with PATH=/usr/bin:/bin.
RUN printf '%s\n' '#!/bin/sh' \
      'fwd=$(env | sed -n "s/^\(WAYLAND_DISPLAY\|DISPLAY\|XDG_CURRENT_DESKTOP\|POLARIS_[A-Za-z0-9_]*\|SDL_[A-Za-z0-9_]*\)=.*/-E \1/p")' \
      'exec systemd-run --user --quiet --collect $fwd -- /usr/bin/steam "$@"' \
      > /usr/bin/steam \
 && chmod 0755 /usr/bin/steam

ENTRYPOINT ["/usr/bin/polaris"]
