[Unit]
Description=Polaris game stream host (rootless podman)
# As upstream's polaris.service: ordering only, deliberately without
# PartOf=graphical-session.target, so the host outlives Game/Desktop Mode
# switches and an active stream is not cut by a session ending.
After=graphical-session.target
StartLimitIntervalSec=500
StartLimitBurst=5

[Container]
Image=polaris.build
ContainerName=polaris
# Same uid as the host user: keeps the user's ACLs on /dev/uinput and /dev/dri/card*
# and lets Polaris use the session's sockets.
UserNS=keep-id
GroupAdd=keep-groups
# Moonlight/Nova ports and the web UI on 47990.
Network=host
# Host /proc: Polaris detects Game Mode and tracks Steam by scanning processes.
PodmanArgs=--pid=host --ipc=host
# Upstream's PassEnvironment=: --env NAME copies each from this unit's
# environment (the user manager's) and skips it when unset.
PodmanArgs=--env WAYLAND_DISPLAY --env DISPLAY --env XDG_CURRENT_DESKTOP --env XDG_SESSION_TYPE --env XDG_SESSION_ID --env XAUTHORITY --env XDG_RUNTIME_DIR --env DBUS_SESSION_BUS_ADDRESS
SecurityLabelDisable=true
AddDevice=/dev/dri
AddDevice=/dev/uinput
# PipeWire (gamescope video node + audio), gamescope-0/-0-ei (libei input), session bus.
Volume=%t:%t
# No /tmp/.X11-unix mount: the private labwc's Xwayland must own that dir, and
# Network=host already shares the host's abstract X sockets both ways.
# Persistent named volume (polaris-config.volume); :U chowns it to the keep-id user.
Volume=polaris-config.volume:%h/.config/polaris:U
# Mesa shader cache and fontconfig cache.
Volume=polaris-cache:%h/.cache:U
# Private Stream writes its labwc config here.
Volume=polaris-labwc:%h/.config/labwc-polaris:U
Volume=%h/.steam:%h/.steam:ro
Volume=%h/.local/share/Steam:%h/.local/share/Steam:ro
Environment=HOME=%h

[Service]
# Avoid starting Polaris before the desktop is fully initialized.
ExecStartPre=/bin/sleep 5
Restart=on-failure
RestartSec=5s
SuccessExitStatus=75
RestartForceExitStatus=75
TimeoutStartSec=900
# Give capture, encode, and audio workers room to request realtime or
# negative-nice priority when the user manager allows it.
LimitRTPRIO=95
LimitNICE=-10

[Install]
# Upstream's desktop autostart, plus its --enable-headless-boot hook (with
# lingering) so Polaris also runs at boot for Game Mode.
WantedBy=xdg-desktop-autostart.target
WantedBy=default.target

[Quadlet]
# SteamOS never activates network-online.target; skip podman's 90s wait for it.
DefaultDependencies=false
