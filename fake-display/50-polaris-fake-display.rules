// Polaris runs as @USER@ and plugs or unplugs the fake display through these
// units only: start polaris-fake-display@WIDTHxHEIGHT-HZ or -unplug, and
// (re)start the idle unplug timer.
polkit.addRule(function (action, subject) {
  if (action.id != "org.freedesktop.systemd1.manage-units" || subject.user != "@USER@") {
    return polkit.Result.NOT_HANDLED;
  }
  var unit = action.lookup("unit"), verb = action.lookup("verb");
  if ((verb == "start" && /^polaris-fake-display(@[0-9]+x[0-9]+-[0-9]+|-unplug)\.service$/.test(unit)) ||
      ((verb == "start" || verb == "restart") && unit == "polaris-fake-display-idle.timer")) {
    return polkit.Result.YES;
  }
  return polkit.Result.NOT_HANDLED;
});
